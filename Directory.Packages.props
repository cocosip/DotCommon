<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Keep transitive pinning off: a range's lower bound would be pinned, and any
      transitive dependency asking for a newer patch (for example HybridCache 9.3.0
      requiring Caching.Memory >= 9.0.3) fails restore with NU1109.
    -->
  </PropertyGroup>

  <!--
    Version lines. The 10.x line is the default for every target framework,
    net9.0 overrides it back to 9.x below. Bump the property, never the PackageVersion.
  -->
  <PropertyGroup>
    <DotCommonMSExtensionsRange>[10.0.0,11.0.0)</DotCommonMSExtensionsRange>
    <DotCommonCachingMemoryRange>[10.0.0,11.0.0)</DotCommonCachingMemoryRange>
    <DotCommonCachingHybridRange>[10.0.0,11.0.0)</DotCommonCachingHybridRange>
    <DotCommonAutoMapperRange>[15.1.4,16.0.0)</DotCommonAutoMapperRange>
  </PropertyGroup>

  <!-- net9.0 stays on the 9.x line. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <DotCommonMSExtensionsRange>[9.0.0,10.0.0)</DotCommonMSExtensionsRange>
    <!-- Caching.Memory needs the 9.0.3 floor: HybridCache 9.3.0 depends on it, a lower floor restores as NU1605. -->
    <DotCommonCachingMemoryRange>[9.0.3,10.0.0)</DotCommonCachingMemoryRange>
    <DotCommonCachingHybridRange>[9.3.0,10.0.0)</DotCommonCachingHybridRange>
  </PropertyGroup>

  <!-- AutoMapper 16 is net10.0 only. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DotCommonAutoMapperRange>[16.3.0,17.0.0)</DotCommonAutoMapperRange>
  </PropertyGroup>

  <!-- Microsoft.Extensions.* and System.Text.Json -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotCommonMSExtensionsRange)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(DotCommonMSExtensionsRange)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(DotCommonMSExtensionsRange)" />
    <PackageVersion Include="System.Text.Json" Version="$(DotCommonMSExtensionsRange)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(DotCommonCachingMemoryRange)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotCommonMSExtensionsRange)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="$(DotCommonCachingHybridRange)" />
  </ItemGroup>

  <!-- Third-party libraries with a line of their own -->
  <PropertyGroup>
    <DotCommonTimeZoneConverterRange>[8.0.0,9.0.0)</DotCommonTimeZoneConverterRange>
    <DotCommonBouncyCastleRange>[2.7.0,3.0.0)</DotCommonBouncyCastleRange>
    <DotCommonDistributedLockRange>[1.0.9,2.0.0)</DotCommonDistributedLockRange>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AutoMapper" Version="$(DotCommonAutoMapperRange)" />
    <PackageVersion Include="TimeZoneConverter" Version="$(DotCommonTimeZoneConverterRange)" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="$(DotCommonBouncyCastleRange)" />
    <PackageVersion Include="DistributedLock.Core" Version="$(DotCommonDistributedLockRange)" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- netstandard-only polyfills, never part of the published dependency groups -->
  <ItemGroup>
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
    <PackageVersion Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <!-- Test tooling -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
