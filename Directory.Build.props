<Project>
	<PropertyGroup>

		<!--
		  Target framework matrix.
		  netstandard2.0 / netstandard2.1 / net9.0 share the 9.x dependency line,
		  only net10.0 moves to the 10.x line. Package versions live in
		  Directory.Packages.props and are switched per TFM.
		-->
		<AllFrameworks>netstandard2.0;netstandard2.1;net9.0;net10.0</AllFrameworks>

		<!-- Frameworks that can host ASP.NET Core / run tests. -->
		<CoreFrameworks>net9.0;net10.0</CoreFrameworks>

		<!-- Newest framework, used by samples. -->
		<LatestFramework>net10.0</LatestFramework>

	</PropertyGroup>
</Project>
